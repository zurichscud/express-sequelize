# 服务端口
PORT=3000

# MySQL 连接配置（示例使用 WSL 容器映射到 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=express_sequelize
DB_USER=app
DB_PASSWORD=your_password

# 设为 true 可打印 Sequelize 生成的 SQL
DB_LOGGING=false

# JWT 签名密钥（生产环境务必使用随机长字符串，例如 openssl rand -hex 32）
JWT_SECRET=change_me_to_a_random_long_string
# token 有效期，支持 30m / 2h / 7d 等写法
JWT_EXPIRES_IN=7d
