# 服务端口
PORT=3000

# MySQL 连接配置（示例使用 WSL 容器映射到 3307）
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=express_sequelize
DB_USER=app
DB_PASSWORD=your_password

# 设为 true 可打印 Sequelize 生成的 SQL
DB_LOGGING=false

# JWT 签名密钥（生产环境务必使用随机长字符串，例如 openssl rand -hex 32）
JWT_SECRET=change_me_to_a_random_long_string
# token 有效期，支持 30m / 2h / 7d 等写法
JWT_EXPIRES_IN=7d

# CORS 来源白名单，逗号分隔；留空则放行所有来源（Access-Control-Allow-Origin: *）
CORS_ORIGIN=

# 阿里云 OSS 上传（后台文件上传，由服务器代理上传到 OSS）
OSS_REGION=oss-cn-shenzhen
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
# 可选：自定义 Endpoint，留空默认 oss-<region>.aliyuncs.com
OSS_ENDPOINT=
# 可选：公开访问域名（CDN 或自定义域名），留空则使用 https://<bucket>.<endpoint>
OSS_PUBLIC_URL=
# 可选：对象目录前缀，最终路径为 <prefix>/<image|video>/<年>/<月>/<uuid>.<ext>
OSS_DIR=uploads
# 可选：上传大小限制（MB），超过会返回 413
OSS_IMAGE_MAX_SIZE_MB=10
OSS_VIDEO_MAX_SIZE_MB=500
# 可选：上传超时（毫秒）
OSS_TIMEOUT=600000
