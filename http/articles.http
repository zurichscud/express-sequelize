### 变量
@baseUrl = http://localhost:3000

### 健康检查
GET {{baseUrl}}/health
Accept: application/json

### 文章列表
GET {{baseUrl}}/api/articles
Accept: application/json

### 文章列表（标题模糊搜索）
GET {{baseUrl}}/api/articles?title=Express
Accept: application/json

### 文章详情
GET {{baseUrl}}/api/articles/1
Accept: application/json

### 创建文章
POST {{baseUrl}}/api/articles
Content-Type: application/json
Accept: application/json

{
  "title": "Express + Sequelize 入门",
  "summary": "从零搭建文章接口",
  "content": "这里是文章正文内容。",
  "author": "张三",
  "status": "published"
}

### 删除文章
DELETE {{baseUrl}}/api/articles/1
Accept: application/json

### 更新文章（仅传需要修改的字段）
PUT {{baseUrl}}/api/articles/1
Content-Type: application/json
Accept: application/json

{
  "title": "更新后的标题",
  "summary": "更新后的摘要",
  "status": "draft"
}